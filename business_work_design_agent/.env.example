APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=business_work_design
# F00 MongoDB Writer와 검색 Component는 canonical collection 이름을 사용하므로 비워 둡니다.
MONGODB_COLLECTION_PREFIX=

# F00/F20/F90의 built-in Embedding Model에서 같은 승인 provider/model과 credential을 설정합니다.
# runtime embedding contract v2는 실제 Embeddings 객체에서 runtime_class, 승인 model_id,
# 첫 vector dimension, fingerprint를 만들므로 별도 HTTP endpoint/token/model/version/dimension 환경변수는 사용하지 않습니다.
# provider credential은 Langflow Secret 또는 Global Variable에만 보관합니다.

# F10 native Playground HITL (active path)
# Answer text is entered directly in each "42 보완 답변 HITL" card.  The card
# sends its node_input schema and submitted values through the authenticated
# Langflow Playground resume mechanism; no F10 external answer-form API or
# browser-visible API key is required.  Every active F10 MongoDB node must use
# this same URI/database: Component 13 (x3), 39 (x3), 18 and 36.
# In Langflow, bind MONGODB_URI as a Secret/Global Variable and keep the
# Component database default as business_work_design.

# Legacy/reference only: these values are consumed by services/hitl_form_api,
# not by the active F10 Flow or its Playground answer card.  Keep them unset
# unless an operator is deliberately testing the separate legacy service.
# LANGFLOW_BASE_URL=http://127.0.0.1:7860
# LANGFLOW_API_KEY=
# LANGFLOW_F10_FLOW_ID=
# LANGFLOW_RESUME_ENABLED=true

# Report API
REPORT_PUBLIC_BASE_URL=http://127.0.0.1:8091/api
REPORT_API_BEARER_TOKEN=
REPORT_STORAGE_MODE=mongodb
# 최소 32 UTF-8 byte. Report API secret store에만 두며 URL이나 Langflow edge로 전달하지 않습니다.
REPORT_VIEW_SIGNING_SECRET=
# Signed browser view/download capability TTL. 허용 범위 60~3600초. Proxy/Uvicorn access log에서 capability query를 숨깁니다.
REPORT_VIEW_TOKEN_TTL_SECONDS=900
# Mongo idempotency PROCESSING lease. Crash 뒤 동일 요청이 복구할 수 있도록 30~3600초 범위로 설정합니다.
REPORT_PROCESSING_LEASE_SECONDS=300
# 현재 idempotency reservation TTL입니다. report/GridFS artifact 삭제는 별도 lifecycle sweeper가 담당합니다.
REPORT_RETENTION_DAYS=90

# Legacy/reference only: services/hitl_form_api is not part of the active F10
# Playground-native answer path.  Leave these unset unless operating that
# separate legacy service for a migration/reference scenario.
# HITL_API_BEARER_TOKEN=
# HITL_STORAGE_MODE=mongodb

# Insecure mode is allowed only for explicit loopback development.
ALLOW_INSECURE_LOCAL=false
