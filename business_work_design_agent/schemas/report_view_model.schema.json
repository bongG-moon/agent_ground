{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/schemas/report_view_model.schema.json",
  "title": "Business Work Design Report View Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "renderer_version", "report_id", "title", "summary", "as_is_graph", "to_be_graph", "sections", "retrieval_trace", "source_contract_hash"],
  "properties": {
    "schema_version": {"const": "report_view_model.v1"},
    "renderer_version": {"const": "business-report-renderer.v1"},
    "report_id": {"type": "string", "pattern": "^report-[0-9a-f]{24}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_definition_id", "work_definition_revision", "approval_status", "approved_hash", "blueprint_id", "blueprint_sha256", "catalog_snapshot_id", "pattern", "pattern_reason", "build_readiness"],
      "properties": {
        "work_definition_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "work_definition_revision": {"type": "integer", "minimum": 0},
        "approval_status": {"const": "APPROVED"},
        "approved_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "blueprint_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "blueprint_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "catalog_snapshot_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "pattern": {"type": "string", "minLength": 1, "maxLength": 128},
        "pattern_reason": {"type": "string", "maxLength": 5000},
        "build_readiness": {"enum": ["design_only", "proposed_unverified", "import_ready"]}
      }
    },
    "as_is_graph": {
      "allOf": [
        {"$ref": "#/$defs/presentation_graph"},
        {"properties": {"graph_kind": {"const": "as_is"}}}
      ]
    },
    "to_be_graph": {
      "allOf": [
        {"$ref": "#/$defs/presentation_graph"},
        {"properties": {"graph_kind": {"const": "to_be"}}}
      ]
    },
    "sections": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/section"}},
    "retrieval_trace": {
      "type": "object",
      "required": ["tenant_id", "snapshot_id", "work_definition_id", "work_definition_revision", "approved_hash", "design_scope_sha256", "query_plan_sha256", "candidate_allowlist_sha256", "candidate_allowlist"],
      "properties": {
        "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "work_definition_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "work_definition_revision": {"type": "integer", "minimum": 0},
        "approved_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "design_scope_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "query_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "candidate_allowlist_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "candidate_allowlist": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset_id", "version", "asset_type", "technical_contract_status", "port_contract_sha256"],
            "properties": {
              "asset_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "version": {"type": "string", "minLength": 1, "maxLength": 100},
              "asset_type": {"enum": ["component", "flow"]},
              "technical_contract_status": {"enum": ["metadata_only", "ports_extracted", "flow_graph_extracted", "verified_runtime"]},
              "port_contract_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "source_contract_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "presentation_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_id", "graph_kind", "build_readiness", "nodes", "edges", "details", "generation_requests", "text_fallback"],
      "properties": {
        "graph_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "graph_kind": {"enum": ["as_is", "to_be"]},
        "build_readiness": {"enum": [null, "design_only", "proposed_unverified", "import_ready"]},
        "layout_direction": {"enum": ["left_to_right", "top_to_bottom"]},
        "nodes": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "source_node_id", "node_kind", "title", "sequence", "implementation_source", "implementation_label", "technical_contract_status", "port_contract_sha256", "summary", "input_ports", "output_ports", "applied_skills", "detail_ref", "generation_request_ref"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "source_node_id": {"type": "string", "maxLength": 128},
              "node_kind": {"enum": ["start", "end", "work_step", "decision", "human_gate", "system_call", "new_custom", "companion_service", "skill_group", "exception"]},
              "title": {"type": "string", "maxLength": 500},
              "sequence": {"type": "integer", "minimum": 0},
              "implementation_source": {"enum": ["builtin", "catalog_component", "catalog_flow", "new_standalone_component", "companion_service", "human_task"]},
              "implementation_label": {"type": "string", "maxLength": 256},
              "technical_contract_status": {"enum": [null, "metadata_only", "ports_extracted", "flow_graph_extracted", "verified_runtime"]},
              "port_contract_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
              "summary": {"type": "string", "maxLength": 10000},
              "input_ports": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/presentation_port"}},
              "output_ports": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/presentation_port"}},
              "applied_skills": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/applied_skill"}},
              "detail_ref": {"type": "string", "minLength": 1, "maxLength": 128},
              "generation_request_ref": {
                "oneOf": [
                  {"type": "null"},
                  {"type": "string", "minLength": 1, "maxLength": 128}
                ]
              }
            },
            "allOf": [
              {"if": {"properties": {"implementation_source": {"enum": ["catalog_component", "catalog_flow"]}}, "required": ["implementation_source"]}, "then": {"properties": {"port_contract_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "else": {"properties": {"port_contract_sha256": {"type": "null"}}}}
            ]
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["edge_id", "source_node_id", "source_port_id", "target_node_id", "target_port_id", "edge_kind", "label", "condition", "is_default", "connection_validation_status", "mapping", "retry_policy"],
            "properties": {
              "edge_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "source_node_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "source_port_id": {
                "oneOf": [
                  {"type": "null"},
                  {"type": "string", "minLength": 1, "maxLength": 256}
                ]
              },
              "target_node_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "target_port_id": {
                "oneOf": [
                  {"type": "null"},
                  {"type": "string", "minLength": 1, "maxLength": 256}
                ]
              },
              "edge_kind": {"enum": ["control", "data", "branch", "human", "retry", "error"]},
              "label": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"},
              "condition": {"type": ["string", "null"], "maxLength": 2000},
              "is_default": {"type": "boolean"},
              "connection_validation_status": {"enum": ["unverified", "contract_compatible", "verified_runtime"]},
              "mapping": {"type": "object"},
              "retry_policy": {"type": "object"}
            }
          }
        },
        "groups": {"type": "array", "maxItems": 500, "items": {"type": "object"}},
        "details": {"type": "object", "additionalProperties": {"$ref": "#/$defs/detail"}},
        "generation_requests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/generation_request"}},
        "text_fallback": {"type": "array", "maxItems": 5000, "items": {"type": "string", "maxLength": 20000}}
      }
    },
    "presentation_port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port_id", "source_port_id", "label", "name", "data_type", "semantic_role", "schema_ref", "required", "cardinality", "has_default", "secret", "permission", "network_zone", "streaming"],
      "properties": {
        "port_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_port_id": {"type": "string", "maxLength": 128},
        "label": {"type": "string", "maxLength": 500},
        "name": {"type": "string", "maxLength": 128},
        "data_type": {"type": "string", "maxLength": 128},
        "semantic_role": {"type": "string", "maxLength": 256},
        "schema_ref": {"type": "string", "maxLength": 1000},
        "required": {"type": "boolean"},
        "cardinality": {"enum": ["one", "many"]},
        "has_default": {"type": "boolean"},
        "secret": {"type": "boolean"},
        "permission": {"type": "string", "maxLength": 500},
        "network_zone": {"type": "string", "maxLength": 128},
        "streaming": {"type": "boolean"}
      }
    },
    "applied_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "name", "version", "prompt_sha256", "match_reason", "target_stage", "source_ref"],
      "properties": {
        "skill_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "match_reason": {"type": "string", "minLength": 1, "maxLength": 5000},
        "target_stage": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_ref": {"const": "approved-skill-registry"}
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "current_work", "problems", "improvement", "reuse_decision_reason", "asset_ref", "inputs", "outputs", "config", "secrets_permissions", "failure_policy", "human_review", "tests", "applied_skills"],
      "properties": {
        "title": {"type": "string", "maxLength": 500},
        "current_work": {"type": "string", "maxLength": 20000},
        "problems": {"type": "array", "maxItems": 500},
        "improvement": {"type": "string", "maxLength": 20000},
        "reuse_decision_reason": {"type": "string", "maxLength": 5000},
        "asset_ref": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["asset_id", "version"], "properties": {"asset_id": {"type": "string", "minLength": 1, "maxLength": 200}, "version": {"type": "string", "minLength": 1, "maxLength": 100}}}]},
        "inputs": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/presentation_port"}},
        "outputs": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/presentation_port"}},
        "config": {"type": "object"},
        "secrets_permissions": {"type": "array", "maxItems": 500},
        "failure_policy": {"type": "object"},
        "human_review": {"type": ["object", "null"]},
        "tests": {"type": "array", "maxItems": 500},
        "applied_skills": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/applied_skill"}}
      }
    },
    "generation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_request_id", "target_node_id", "template_version", "prompt_pack", "component_filename", "class_name", "prompt_sha256", "request_text"],
      "properties": {
        "generation_request_id": {"type": "string", "pattern": "^gen-[0-9a-f]{20}$"},
        "target_node_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "template_version": {"const": "ccp-base-2026-08-27.v1"},
        "prompt_pack": {"enum": ["CCP-CATALOG", "CCP-WORK", "CCP-SEARCH-SKILL", "CCP-BLUEPRINT", "CCP-REPORT"]},
        "component_filename": {"type": "string", "pattern": "^[0-9]{2}_[a-z][a-z0-9_]{1,80}\\.py$"},
        "class_name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]{2,100}Component$"},
        "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "request_text": {"type": "string", "minLength": 1, "maxLength": 200000}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "title", "items"],
      "properties": {
        "section_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "items": {"type": "array", "maxItems": 1000}
      }
    }
  }
}
