{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/schemas/agent_blueprint.schema.json",
  "title": "Agent Blueprint",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "tenant_id", "blueprint_id", "work_definition_id", "work_definition_revision", "approved_hash", "catalog_snapshot_id", "pattern", "nodes", "edges", "flow_import_verified", "build_readiness", "readiness_assessment"],
  "properties": {
    "schema_version": {"const": "agent-blueprint.v1"},
    "terminal_contract": {"const": true},
    "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "blueprint_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "work_definition_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "work_definition_revision": {"type": "integer", "minimum": 0},
    "approved_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "catalog_snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "design_scope_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Required by the sealed F20 terminal blueprint and F30 report boundary; optional only for pre-scope intermediate normalization."},
    "query_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Required by the sealed F20 terminal blueprint and F30 report boundary; optional only for pre-scope intermediate normalization."},
    "candidate_allowlist_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Required by the sealed F20 terminal blueprint and F30 report boundary; optional only for pre-scope intermediate normalization."},
    "pattern": {"enum": ["deterministic_sequential", "single_agent_allowlisted_tools", "parent_with_child_flows", "producer_reviewer", "bounded_fan_out", "flow_without_agent"]},
    "pattern_reason": {"type": "string", "maxLength": 5000},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/edge"}},
    "applied_skills": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/applied_skill"}},
    "generation_requests": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/generation_request"}},
    "flow_import_verified": {"type": "boolean"},
    "build_readiness": {"enum": ["design_only", "proposed_unverified", "import_ready"]},
    "readiness_assessment": {"$ref": "#/$defs/readiness_assessment"}
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port_id", "data_type", "cardinality", "required"],
      "properties": {
        "port_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "maxLength": 128},
        "data_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "semantic_role": {"type": "string", "maxLength": 256},
        "schema_ref": {"type": "string", "maxLength": 1000},
        "cardinality": {"enum": ["one", "many"]},
        "required": {"type": "boolean"},
        "has_default": {"type": "boolean"},
        "secret": {"type": "boolean"},
        "permission": {"type": "string", "maxLength": 500},
        "network_zone": {"type": "string", "maxLength": 128},
        "streaming": {"type": "boolean"}
      }
    },
    "required_secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "maxLength": 300},
        "ref": {"type": "string", "maxLength": 300},
        "port_id": {"type": "string", "maxLength": 300},
        "required": {"type": "boolean"},
        "configured": {"type": "boolean"}
      },
      "anyOf": [{"required": ["name"]}, {"required": ["ref"]}, {"required": ["port_id"]}]
    },
    "required_permission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "maxLength": 300},
        "ref": {"type": "string", "maxLength": 300},
        "required": {"type": "boolean"},
        "granted": {"type": "boolean"}
      },
      "anyOf": [{"required": ["name"]}, {"required": ["ref"]}]
    },
    "generation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_filename", "class_name", "display_name", "responsibility", "input_contract", "output_contract", "secret_inputs", "dependencies", "timeout_limits", "error_codes", "deployment_mode", "prompt_pack"],
      "properties": {
        "component_filename": {"type": "string", "pattern": "^[0-9]{2}_[a-z][a-z0-9_]{1,80}\\.py$"},
        "class_name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]{2,100}Component$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 300},
        "responsibility": {"type": "string", "minLength": 1, "maxLength": 3000},
        "input_contract": {"type": "object", "minProperties": 1},
        "output_contract": {"type": "object", "minProperties": 1},
        "secret_inputs": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/required_secret"}},
        "dependencies": {"type": "array", "maxItems": 100, "items": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 300}, {"type": "object"}]}},
        "timeout_limits": {"type": "object", "minProperties": 1},
        "error_codes": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "deployment_mode": {"type": "string", "minLength": 1, "maxLength": 128},
        "prompt_pack": {"enum": ["CCP-CATALOG", "CCP-WORK", "CCP-SEARCH-SKILL", "CCP-BLUEPRINT", "CCP-REPORT"]}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": ["node_id", "node_type", "title", "responsibility", "implementation_source", "asset_ref", "port_contract_sha256", "technical_contract_status", "reuse_decision_reason", "inputs", "outputs", "applied_skills"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "node_type": {"enum": ["start", "task", "decision", "human_review", "system_call", "subflow", "end", "exception"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "responsibility": {"type": "string", "minLength": 1, "maxLength": 5000},
        "current_work": {"type": "string", "maxLength": 20000},
        "problems": {"type": "array", "maxItems": 50},
        "improvement": {"type": "string", "maxLength": 20000},
        "implementation_source": {"enum": ["builtin", "catalog_component", "catalog_flow", "new_standalone_component", "companion_service", "human_task"]},
        "asset_ref": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["asset_id", "version"], "properties": {"asset_id": {"type": "string", "minLength": 1, "maxLength": 200}, "version": {"type": "string", "minLength": 1, "maxLength": 100}}}]},
        "port_contract_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "reuse_decision_reason": {"type": "string", "minLength": 1, "maxLength": 5000},
        "technical_contract_status": {"enum": [null, "metadata_only", "ports_extracted", "flow_graph_extracted", "verified_runtime"]},
        "inputs": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/port"}},
        "outputs": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/port"}},
        "required_secrets": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/required_secret"}},
        "required_permissions": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/required_permission"}},
        "applied_skills": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/applied_skill"}},
        "generation_contract": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/generation_contract"}]},
        "generation_request_ref": {
          "type": ["string", "null"],
          "maxLength": 128,
          "description": "F30 terminal report input requires every new_standalone_component to bind exactly one non-null ref to the root generation_requests registry. Intermediate design_only blueprints may keep this null until Component 26 completes."
        }
      },
      "allOf": [
        {"not": {"required": ["generation_request"]}},
        {"if": {"properties": {"implementation_source": {"const": "new_standalone_component"}}, "required": ["implementation_source"]}, "then": {"required": ["generation_contract"], "properties": {"generation_contract": {"$ref": "#/$defs/generation_contract"}}}, "else": {"properties": {"generation_contract": {"type": "null"}}}},
        {"if": {"properties": {"implementation_source": {"enum": ["catalog_component", "catalog_flow"]}}, "required": ["implementation_source"]}, "then": {"properties": {"asset_ref": {"type": "object"}, "port_contract_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "else": {"properties": {"asset_ref": {"type": "null"}, "port_contract_sha256": {"type": "null"}}}}
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": ["edge_id", "source_node_id", "target_node_id", "label", "is_default", "connection_validation_status"],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "source_node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "source_port_id": {"type": ["string", "null"]},
        "target_node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "target_port_id": {"type": ["string", "null"]},
        "label": {"type": "string", "maxLength": 500},
        "branch_label": {"type": "string", "maxLength": 500},
        "condition": {"type": ["string", "null"], "maxLength": 2000},
        "is_default": {"type": "boolean"},
        "default": {"type": "boolean"},
        "connection_validation_status": {"enum": ["unverified", "contract_compatible", "verified_runtime"]}
      }
    },
    "generation_request": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generation_request_id", "target_node_id", "template_version", "prompt_pack", "component_filename", "class_name", "prompt_sha256", "request_text"],
      "properties": {
        "generation_request_id": {"type": "string", "pattern": "^gen-[0-9a-f]{20}$"},
        "target_node_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "template_version": {"const": "ccp-base-2026-08-27.v1"},
        "prompt_pack": {"enum": ["CCP-CATALOG", "CCP-WORK", "CCP-SEARCH-SKILL", "CCP-BLUEPRINT", "CCP-REPORT"]},
        "component_filename": {"type": "string", "pattern": "^[0-9]{2}_[a-z][a-z0-9_]{1,80}\\.py$"},
        "class_name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]{2,100}Component$"},
        "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "request_text": {"type": "string", "minLength": 1, "maxLength": 200000}
      }
    },
    "applied_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "name", "version", "prompt_sha256", "match_reason", "target_stage", "source_ref"],
      "properties": {
        "skill_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "match_reason": {"type": "string", "minLength": 1, "maxLength": 5000},
        "target_stage": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_ref": {"const": "approved-skill-registry"}
      }
    },
    "readiness_item": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "ref": {"type": ["string", "null"], "maxLength": 300}
      }
    },
    "readiness_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_axis", "technical_status_axis", "connection_status_axis", "blockers", "warnings", "import_requirements", "flow_import_verified"],
      "properties": {
        "status_axis": {"const": "build_readiness"},
        "technical_status_axis": {"const": "technical_contract_status"},
        "connection_status_axis": {"const": "connection_validation_status"},
        "blockers": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/readiness_item"}},
        "warnings": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/readiness_item"}},
        "import_requirements": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/readiness_item"}},
        "flow_import_verified": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"build_readiness": {"const": "import_ready"}}, "required": ["build_readiness"]},
      "then": {
        "properties": {
          "flow_import_verified": {"const": true},
          "readiness_assessment": {
            "properties": {
              "flow_import_verified": {"const": true},
              "blockers": {"maxItems": 0},
              "import_requirements": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"build_readiness": {"const": "proposed_unverified"}}, "required": ["build_readiness"]},
      "then": {
        "properties": {
          "readiness_assessment": {
            "properties": {
              "import_requirements": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"terminal_contract": {"const": true}}, "required": ["terminal_contract"]},
      "then": {
        "required": ["design_scope_sha256", "query_plan_sha256", "candidate_allowlist_sha256", "generation_requests"],
        "properties": {
          "nodes": {
            "items": {
              "if": {
                "properties": {"implementation_source": {"const": "new_standalone_component"}},
                "required": ["implementation_source"]
              },
              "then": {
                "required": ["generation_request_ref"],
                "properties": {"generation_request_ref": {"type": "string", "minLength": 1, "maxLength": 128}}
              }
            }
          }
        }
      }
    }
  ]
}
