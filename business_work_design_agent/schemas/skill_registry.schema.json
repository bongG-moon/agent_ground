{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/schemas/skill_registry.schema.json",
  "title": "Approved Skill Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "skill_id", "name", "version", "prompt_sha256", "trigger_rules", "near_miss_rules", "prompt_text", "status", "acl", "approved_by", "approved_at"],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,127}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "trigger_rules": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/rule"}},
    "near_miss_rules": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/rule"}},
    "prompt_text": {"type": "string", "minLength": 1, "maxLength": 50000},
    "forbidden_actions": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 128}},
    "status": {"enum": ["active", "inactive", "revoked"]},
    "acl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "groups"],
      "properties": {
        "visibility": {"enum": ["private", "group", "tenant"]},
        "groups": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "subjects": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      },
      "allOf": [
        {
          "if": {"properties": {"visibility": {"const": "group"}}, "required": ["visibility"]},
          "then": {"properties": {"groups": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"visibility": {"const": "private"}}, "required": ["visibility"]},
          "then": {"required": ["subjects"], "properties": {"subjects": {"minItems": 1}}}
        }
      ]
    },
    "approved_by": {"type": "string", "minLength": 1, "maxLength": 256},
    "approved_at": {"type": "string", "format": "date-time", "maxLength": 64, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "match_reason": {"type": "string", "maxLength": 500},
    "target_stage": {"type": "string", "maxLength": 100}
  },
  "$defs": {
    "rule": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 1000},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["contains", "all"]},
            "value": {"type": "string", "minLength": 1, "maxLength": 1000},
            "values": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
            "terms": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
          },
          "oneOf": [{"required": ["value"]}, {"required": ["values"]}, {"required": ["terms"]}]
        }
      ]
    }
  }
}
