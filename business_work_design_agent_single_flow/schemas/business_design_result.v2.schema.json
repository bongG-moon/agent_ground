{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "business-design-result/v2",
  "title": "Business Design Result v2",
  "description": "Authoritative, normalized result from Component 05. It contains no tenant, session, approval, MongoDB, or active-snapshot state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "request", "work_analysis", "information_gaps", "as_is_graph", "to_be_design", "catalog_application", "warnings", "trace"],
  "properties": {
    "schema_version": {"const": "business-design-result/v2"},
    "status": {"enum": ["COMPLETED", "COMPLETED_WITH_GAPS"]},
    "request": {"type": "object"},
    "work_analysis": {"type": "object", "required": ["title", "goal", "scope_in", "scope_out", "actors", "systems", "inputs", "outputs", "trigger_and_frequency", "constraints", "success_criteria", "current_steps", "current_branches", "current_exceptions", "problems"]},
    "information_gaps": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/gap"}},
    "as_is_graph": {"$ref": "#/$defs/normalizedGraph"},
    "to_be_design": {"type": "object", "required": ["summary", "principles", "nodes", "edges", "implementation_roadmap", "risks_and_controls", "test_scenarios"]},
    "catalog_application": {"type": "object", "additionalProperties": false, "required": ["candidate_count", "selected", "considered", "not_used"], "properties": {"candidate_count": {"type": "integer", "minimum": 0, "maximum": 100}, "selected": {"type": "array", "items": {"$ref": "#/$defs/catalogDecision"}}, "considered": {"type": "array", "items": {"$ref": "#/$defs/catalogDecision"}}, "not_used": {"type": "array", "items": {"$ref": "#/$defs/catalogDecision"}}}},
    "refinement": {"type": "object", "additionalProperties": false, "required": ["status", "operator_instruction_provided"], "properties": {"status": {"enum": ["APPLIED", "SKIPPED"]}, "reason_code": {"enum": ["MODEL_UNAVAILABLE", "STRUCTURED_OUTPUT_UNAVAILABLE", "MODEL_OUTPUT_INVALID", "REFINEMENT_TIMEOUT", "REFINEMENT_NOT_RUN"]}, "operator_instruction_provided": {"type": "boolean"}, "message": {"type": "string", "maxLength": 500}}},
    "warnings": {"type": "array", "maxItems": 200, "items": {"type": "string", "maxLength": 128}},
    "trace": {"type": "object", "required": ["source_description_sha256", "request_sha256", "catalog_file_sha256", "candidate_set_sha256", "top_n", "ranking_algorithm", "model_identifier"]}
  },
  "$defs": {
    "gap": {"type": "object", "additionalProperties": false, "required": ["gap_id", "field", "severity", "question", "why_needed", "design_impact", "suggested_description_text"], "properties": {"gap_id": {"type": "string", "maxLength": 128}, "field": {"type": "string", "maxLength": 128}, "severity": {"enum": ["required", "important", "optional"]}, "question": {"type": "string", "maxLength": 5000}, "why_needed": {"type": "string", "maxLength": 5000}, "design_impact": {"type": "string", "maxLength": 5000}, "suggested_description_text": {"type": "string", "maxLength": 5000}}},
    "normalizedNode": {"type": "object", "additionalProperties": false, "required": ["node_id", "node_kind", "title", "summary", "sequence", "actor", "system", "inputs", "outputs", "implementation_source", "catalog_asset_refs"], "properties": {"node_id": {"type": "string", "maxLength": 128}, "node_kind": {"enum": ["start", "end", "work_step", "decision", "human_review", "system_call", "exception"]}, "title": {"type": "string", "maxLength": 500}, "summary": {"type": "string", "maxLength": 5000}, "sequence": {"type": "integer", "minimum": 0}, "actor": {"type": "string", "maxLength": 500}, "system": {"type": "string", "maxLength": 500}, "inputs": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 5000}}, "outputs": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 5000}}, "implementation_source": {"enum": ["human_task", "builtin", "catalog_component", "catalog_flow", "new_component", "external_service"]}, "catalog_asset_refs": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["asset_id", "version"], "properties": {"asset_id": {"type": "string"}, "version": {"type": "string"}}}}}},
    "normalizedEdge": {"type": "object", "additionalProperties": false, "required": ["edge_id", "source_node_id", "target_node_id", "edge_kind", "label", "condition", "is_default", "retry_policy"], "properties": {"edge_id": {"type": "string", "maxLength": 128}, "source_node_id": {"type": "string", "maxLength": 128}, "target_node_id": {"type": "string", "maxLength": 128}, "edge_kind": {"enum": ["control", "branch", "error", "retry"]}, "label": {"type": "string", "maxLength": 500}, "condition": {"type": "string", "maxLength": 5000}, "is_default": {"type": "boolean"}, "retry_policy": {"type": "object"}}},
    "normalizedGraph": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges"], "properties": {"nodes": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/normalizedNode"}}, "edges": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/normalizedEdge"}}}},
    "catalogDecision": {"type": "object", "additionalProperties": false, "required": ["asset_id", "version", "title", "asset_type", "technical_contract_status", "catalog_url", "target_node_ids", "reason", "required_verification", "decision_source"], "properties": {"asset_id": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"}, "version": {"type": "string", "maxLength": 100}, "title": {"type": "string", "maxLength": 500}, "asset_type": {"enum": ["component", "flow"]}, "technical_contract_status": {"enum": ["metadata_only", "ports_extracted", "flow_graph_extracted", "verified_runtime", "unknown"]}, "catalog_url": {"type": "string", "pattern": "^https://agent-hub\\.skhynix\\.com/#/(component|flow)/[0-9a-fA-F-]{36}$"}, "target_node_ids": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 128}}, "reason": {"type": "string", "maxLength": 5000}, "required_verification": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 5000}}, "decision_source": {"enum": ["llm", "default_fill"]}}}
  }
}
