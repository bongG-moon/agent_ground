{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ground.local/schemas/local-catalog-bundle.v2.schema.json",
  "title": "Local Catalog Bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "counts", "items"],
  "properties": {
    "schema_version": {"const": "local-catalog-bundle/v2"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "file_sha256", "file_size_bytes"],
      "properties": {
        "file_name": {"type": "string", "minLength": 1, "maxLength": 255},
        "file_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "file_size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_items", "valid_items", "removed_secret_fields", "ignored_source_url_fields", "derived_agent_hub_links"],
      "properties": {
        "input_items": {"type": "integer", "minimum": 1},
        "valid_items": {"type": "integer", "minimum": 1},
        "removed_secret_fields": {"type": "integer", "minimum": 0},
        "ignored_source_url_fields": {"type": "integer", "minimum": 0},
        "derived_agent_hub_links": {"type": "integer", "minimum": 1}
      }
    },
    "items": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "version", "asset_type", "title", "description", "category", "readme", "aliases", "capabilities", "systems", "tags", "use_cases", "limitations", "technical_contract_status", "stars_count", "downloads_count", "updated_at", "catalog_url", "ports", "search_text", "content_sha256"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "asset_type": {"enum": ["component", "flow"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "description": {"type": "string", "maxLength": 10000},
        "category": {"type": "string", "maxLength": 500},
        "readme": {"type": "string", "maxLength": 200000},
        "aliases": {"$ref": "#/$defs/text_list"},
        "capabilities": {"$ref": "#/$defs/text_list"},
        "systems": {"$ref": "#/$defs/text_list"},
        "tags": {"$ref": "#/$defs/text_list"},
        "use_cases": {"$ref": "#/$defs/text_list"},
        "limitations": {"$ref": "#/$defs/text_list"},
        "technical_contract_status": {"enum": ["metadata_only", "ports_extracted", "flow_graph_extracted", "verified_runtime", "unknown"]},
        "stars_count": {"type": "integer", "minimum": 0},
        "downloads_count": {"type": "integer", "minimum": 0},
        "updated_at": {"type": "string", "maxLength": 100},
        "catalog_url": {"type": "string", "pattern": "^https://agent-hub\\.skhynix\\.com/#/(?:component|flow)/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "ports": {"type": "object", "additionalProperties": false, "required": ["inputs", "outputs"], "properties": {"inputs": {"type": "array", "maxItems": 500}, "outputs": {"type": "array", "maxItems": 500}}},
        "search_text": {"type": "string", "maxLength": 6000},
        "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "text_list": {"type": "array", "maxItems": 200, "items": {"type": "string", "maxLength": 500}}
  }
}
